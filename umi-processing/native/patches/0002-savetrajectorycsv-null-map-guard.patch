umiproc patch 0002: SaveTrajectoryCSV does not crash when no map has a keyframe

What: System::SaveTrajectoryCSV initialises pBiggerMap to nullptr; when no map has a keyframe it writes the CSV
header only and returns.
Why: pBiggerMap was uninitialised, so a run in which every map was reset (no keyframe anywhere) segfaulted
instead of writing a trajectory in which every frame is lost.
Behaviour change: only in that case (a header-only CSV instead of a crash).

diff --git a/src/System.cc b/src/System.cc
index 15c28e2..04e5066 100644
--- a/src/System.cc
+++ b/src/System.cc
@@ -617,7 +617,7 @@ void System::SaveTrajectoryCSV(const string &filename)
     // Select the appropriate Map
     vector<Map*> vpMaps = mpAtlas->GetAllMaps();
     int numMaxKFs = 0;
-    Map* pBiggerMap;
+    Map* pBiggerMap = nullptr;  // umiproc patch 0002: was uninitialised (segfault when no map has a keyframe)
     std::cout << "There are " << std::to_string(vpMaps.size()) << " maps in the atlas" << std::endl;
     for(Map* pMap :vpMaps)
     {
@@ -629,6 +629,14 @@ void System::SaveTrajectoryCSV(const string &filename)
         }
     }
 
+    if(pBiggerMap == nullptr)
+    {
+        // umiproc patch 0002: no keyframe in any map: write the header only (every frame lost), not crash
+        ofstream fh(filename.c_str());
+        fh << "frame_idx,timestamp,state,is_lost,is_keyframe,x,y,z,q_x,q_y,q_z,q_w" << endl;
+        cout << "No keyframes in any map: wrote the header only to " << filename << endl;
+        return;
+    }
     vector<KeyFrame*> vpKFs = pBiggerMap->GetAllKeyFrames();
     sort(vpKFs.begin(),vpKFs.end(),KeyFrame::lId);
 
