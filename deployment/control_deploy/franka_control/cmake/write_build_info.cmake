# New (control_deploy/STRUCTURE.md section 3.1). Run by the `build_info` target on every build:
#   cmake -DSOURCE_DIR=<franka_control/> -DCONTRACTS_DIR=<deployment/contracts> -DOUTPUT=<build_info.h> -P this
# Writes kGitCommit (the full `git rev-parse HEAD`, or "unknown" without git) and kGitDirty (tracked changes in
# deployment/contracts/ or control_deploy/). hello.commit carries kGitCommit (deployment/STRUCTURE.md 3.8 obligation 3);
# the dirty flag is only shown by --version and warned on by `control_deploy check`. The file is rewritten only when
# its text changes, so an unchanged commit recompiles nothing.
if(NOT SOURCE_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "write_build_info.cmake needs -DSOURCE_DIR=... -DOUTPUT=...")
endif()
get_filename_component(_deploy_dir "${SOURCE_DIR}/.." ABSOLUTE)
if(NOT CONTRACTS_DIR)
  get_filename_component(CONTRACTS_DIR "${SOURCE_DIR}/../../contracts" ABSOLUTE)
endif()

set(_commit "unknown")
set(_dirty "false")
find_program(_git git)
if(_git)
  execute_process(COMMAND "${_git}" -C "${SOURCE_DIR}" rev-parse HEAD
                  OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rc)
  if(_rc EQUAL 0 AND _head MATCHES "^[0-9a-f]+$")
    string(LENGTH "${_head}" _len)
    if(_len EQUAL 40)
      set(_commit "${_head}")
      execute_process(COMMAND "${_git}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no --
                              "${CONTRACTS_DIR}" "${_deploy_dir}"
                      OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rc2)
      if(_rc2 EQUAL 0 AND NOT _status STREQUAL "")
        set(_dirty "true")
      endif()
    endif()
  endif()
endif()

set(_text "// Generated by cmake/write_build_info.cmake on every build. Do not edit.
#pragma once

namespace franka_control {

inline constexpr const char* kGitCommit = \"${_commit}\";   // 40 lowercase hex, or \"unknown\"
inline constexpr bool kGitDirty = ${_dirty};                // tracked changes in contracts/ or control_deploy/

}  // namespace franka_control
")
set(_old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _text)
  get_filename_component(_out_dir "${OUTPUT}" DIRECTORY)
  file(MAKE_DIRECTORY "${_out_dir}")
  file(WRITE "${OUTPUT}" "${_text}")
endif()
