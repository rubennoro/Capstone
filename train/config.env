# train/ settings: sourced by every train/*.sh script on the laptop, and (as a synced copy in CLUSTER_TOOLS) by the
# cluster-side scripts in train/cluster/. Plain bash: KEY="value", no spaces around '='.
#
# Fill every "<...>" placeholder before the first run; a script that needs an unfilled value stops and names it.
# Personal or temporary overrides go in train/config.local.env (same syntax, untracked, read after this file and
# synced to the cluster next to it), e.g.  JETSON_HOST="jetson"   or   SLURM_TIME="04:00:00".
#
# Remote paths (Jetson and cluster) are relative to the remote home directory unless they start with '/'.
# Do not write "~/..." for them; "data" means ~/data on the Jetson.

# ---------------------------------------------------------------------------------------------- Jetson (data side)

# ssh target of the Jetson that runs dataproc: user@host, user@ip, or a Host alias from ~/.ssh/config.
# Example: JETSON_HOST="ruben@192.168.1.50"   or   JETSON_HOST="jetson"
JETSON_HOST="<user@jetson-host or ~/.ssh/config alias>"

# Extra ssh options for the Jetson (split on spaces; also used by rsync). Empty = none.
# Example: JETSON_SSH_OPTS="-p 2222 -i ~/.ssh/id_jetson"
JETSON_SSH_OPTS=""

# dataproc data root on the Jetson ($DATAPROC_ROOT there), relative to the Jetson home or absolute.
# It holds tasks/<folder>/ and datasets/<label>/<dataset>/. Example: JETSON_DATAPROC_ROOT="data"  (= ~/data)
JETSON_DATAPROC_ROOT="data"

# Shell command run on the Jetson before `dataproc` (only for pull.sh --package): puts dataproc on PATH.
# Example: JETSON_ACTIVATE="source ~/envs/env_dataproc/bin/activate"
JETSON_ACTIVATE="source ~/envs/env_dataproc/bin/activate"

# ------------------------------------------------------------------------------------- cluster (Northeastern Explorer)

# Your Explorer username. Example: CLUSTER_USER="noroian.r"
CLUSTER_USER="noroian.r"

# Login node: ssh commands and sbatch run here. Example: CLUSTER_LOGIN="noroian.r@login.explorer.northeastern.edu"
CLUSTER_LOGIN="${CLUSTER_USER}@login.explorer.northeastern.edu"

# Transfer node: bulk copies (dataset upload, result fetch) go through here. Same home directory as the login node.
# Example: CLUSTER_XFER="noroian.r@xfer.discovery.neu.edu"
CLUSTER_XFER="${CLUSTER_USER}@xfer.discovery.neu.edu"

# Extra ssh options for both cluster hosts (split on spaces; also used by rsync). The ControlMaster options keep one
# ssh connection open and reuse it for 10 minutes, so you answer Duo once per 10 min instead of once per connection
# (a submit makes ~3). The ~ in ControlPath is expanded by your local ssh. To turn it off, delete the three
# Control* options. Example: CLUSTER_SSH_OPTS="-o ServerAliveInterval=30 -o ConnectTimeout=20"
CLUSTER_SSH_OPTS="-o ServerAliveInterval=30 -o ConnectTimeout=20 -o ControlMaster=auto -o ControlPath=~/.ssh/cm-%r@%h:%p -o ControlPersist=10m"

# Project folder on the cluster, relative to the cluster home. Example: CLUSTER_ROOT="CapstoneProject"
CLUSTER_ROOT="CapstoneProject"

# Repo clone on the cluster (on main, >= 4be9982 for eval). Example: CLUSTER_REPO="${CLUSTER_ROOT}/Capstone"
CLUSTER_REPO="${CLUSTER_ROOT}/Capstone"

# Uploaded datasets: <CLUSTER_DATASETS>/<label>/<dataset>/<dataset>.zarr.zip. Example: "${CLUSTER_ROOT}/datasets"
CLUSTER_DATASETS="${CLUSTER_ROOT}/datasets"

# Packaged training runs: <CLUSTER_RUNS>/<label>/<run>/. In the home quota: one slim checkpoint is ~2.5 GB, so a run
# is ~2.5 GB by default (TOPK=1); delete old runs there once fetched. Example: CLUSTER_RUNS="${CLUSTER_ROOT}/policies"
CLUSTER_RUNS="${CLUSTER_ROOT}/policies"

# Where submit.sh / eval.sh copy train/cluster/* and these config files before each submission.
# Example: CLUSTER_TOOLS="${CLUSTER_ROOT}/train_tools"
CLUSTER_TOOLS="${CLUSTER_ROOT}/train_tools"

# Slurm job logs (<job-name>_<jobid>.out). Example: CLUSTER_LOGS="${CLUSTER_ROOT}/logs"
CLUSTER_LOGS="${CLUSTER_ROOT}/logs"

# Conda module and environment loaded by the jobs. Example: CLUSTER_CONDA_MODULE="anaconda3/2024.06"
CLUSTER_CONDA_MODULE="anaconda3/2024.06"
# Example: CLUSTER_CONDA_ENV="bp"
CLUSTER_CONDA_ENV="bp"

# ------------------------------------------------------------------------------------------------ Slurm resources

# Full training job. Example: SLURM_PARTITION="gpu"
SLURM_PARTITION="gpu"
# GPU request. Example: SLURM_GRES="gpu:h200:1"
SLURM_GRES="gpu:h200:1"
# Wall-time limit (HH:MM:SS or D-HH:MM:SS); also the budget submit.sh sizes epochs against. Example: "08:00:00"
SLURM_TIME="08:00:00"
# CPU cores. Example: SLURM_CPUS="16"
SLURM_CPUS="16"
# Memory. Example: SLURM_MEM="64G"
SLURM_MEM="64G"
# Slurm account; empty = no --account flag. Example: SLURM_ACCOUNT="my_lab_account"
SLURM_ACCOUNT=""

# Smoke-test job (3 epochs, eval every epoch). Example: SMOKE_PARTITION="gpu-short"
SMOKE_PARTITION="gpu-short"
# Example: SMOKE_TIME="02:00:00"
SMOKE_TIME="02:00:00"

# Offline-eval job (train/analysis/eval.sh). Example: EVAL_PARTITION="gpu-short"
EVAL_PARTITION="gpu-short"
# Example: EVAL_TIME="01:00:00"
EVAL_TIME="01:00:00"

# ------------------------------------------------------------------------------------------------- epoch sizing

# Epochs of a full run when --epochs is not given (run_001 overfit after ~50). Example: DEFAULT_EPOCHS="60"
DEFAULT_EPOCHS="60"
# Measured speed: minutes per epoch per 10,000 dataset steps on one H200 (DIRECTIONS.md). Example: "0.55"
MIN_PER_EPOCH_PER_10K_STEPS="0.55"
# Minutes of SLURM_TIME kept free for startup, evaluation and packaging; epochs must fit in the rest. Example: "40"
TIME_MARGIN_MIN="40"
# How many best checkpoints (by val action MSE) a run keeps and packages, and fetch.sh copies by default. One slim
# checkpoint is ~2.5 GB per run; submit.sh --topk K / fetch.sh --top N still allow more. Example: TOPK="1"
TOPK="1"

# ---------------------------------------------------------------------------------------------------- laptop side

# Local data folder: data/<folder>/ mirrors the Jetson task folder, with package/, policy/ and analysis/ inside.
# TRAIN_DIR is this train/ folder, so the default is <repo>/data. Example: LOCAL_DATA_ROOT="$HOME/Capstone/data"
LOCAL_DATA_ROOT="${TRAIN_DIR:-.}/../data"

# pull.sh / fetch.sh refuse a transfer that would leave less than this many GB free on the laptop (--force skips).
# Example: MIN_FREE_GB="5"
MIN_FREE_GB="5"
