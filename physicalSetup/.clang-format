# physicalSetup C++ style: Google-based, 120 columns.
BasedOnStyle: Google
Language: Cpp
Standard: c++17
ColumnLimit: 120
IndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'          # C++ standard library
    Priority: 1
  - Regex: '^<.*\.h>$'            # C / system headers
    Priority: 2
  - Regex: '^<.*>$'               # third-party
    Priority: 3
  - Regex: '^"rig/'               # this project
    Priority: 4
  - Regex: '.*'
    Priority: 5
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortCaseLabelsOnASingleLine: true
